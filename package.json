{
  "name": "sapling-tv",
  "version": "0.2.0",
  "description": "Unofficial TV-style app for watching Apple TV on Linux, built on the Longboard browser. Not affiliated with Apple.",
  "private": true,
  "license": "GPL-3.0-only",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build && node scripts/check-rules.mjs",
    "start": "npm run build && electron . --dev",
    "tv": "npm run build && electron .",
    "e2e": "npm run build && node test/e2e/run.mjs",
    "dist": "npm run build && electron-builder --linux",
    "live:walk": "npm run build && node test/live/walk.mjs"
  },
  "build": {
    "appId": "io.github.andrewgbest.SaplingTV",
    "productName": "Sapling TV",
    "artifactName": "SaplingTV-${arch}.${ext}",
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "files": [
      "dist/**",
      "profiles/**",
      "assets/**",
      "package.json"
    ],
    "linux": {
      "category": "AudioVideo",
      "synopsis": "TV-style front end for a streaming site you already subscribe to",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "syncDesktopName": true
    },
    "directories": {
      "output": "release"
    },
    "flatpak": {
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "25.08",
      "sdk": "org.freedesktop.Sdk",
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "25.08",
      "finishArgs": [
        "--share=ipc",
        "--share=network",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--socket=pulseaudio",
        "--device=all",
        "--talk-name=org.freedesktop.ScreenSaver",
        "--talk-name=org.freedesktop.PowerManagement",
        "--own-name=org.mpris.MediaPlayer2.chromium.*"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "github:castlabs/electron-releases#v45.2.1+wvcus",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "longboard": "github:AndrewGBest/Longboard#304caf931ec63d6937d3798953cd1c5201899190",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "author": "Sapling TV contributors",
  "desktopName": "io.github.andrewgbest.SaplingTV.desktop"
}
